ALIGNER_DATA_DIR=./data
ALIGNER_DEFAULT_ENGINE=qwen3
ALIGNER_API_TOKEN=

# Download safety.
ALIGNER_ALLOW_HTTP=false
ALIGNER_ALLOW_PRIVATE_HOSTS=false
ALIGNER_MAX_AUDIO_BYTES=83886080
ALIGNER_MAX_AUDIO_DURATION_SECONDS=600
ALIGNER_DOWNLOAD_TIMEOUT_SECONDS=20
ALIGNER_MAX_REDIRECTS=5
ALIGNER_DOWNLOAD_REFERER=
ALIGNER_USER_AGENT=ClaudioLyricAligner/0.1

# Optional vocal separation. Requires demucs and enough GPU/CPU memory.
ALIGNER_ENABLE_DEMUCS=false
ALIGNER_DEMUCS_CMD=demucs
ALIGNER_DEMUCS_MODEL=htdemucs

# Qwen3 official ForcedAligner adapter.
ALIGNER_QWEN_MODEL_PATH=Qwen/Qwen3-ForcedAligner-0.6B
ALIGNER_QWEN_DEVICE_MAP=cuda:0
ALIGNER_QWEN_DTYPE=bfloat16
ALIGNER_QWEN_MAX_WINDOW_MS=300000
ALIGNER_QWEN_WINDOW_PAD_MS=0
ALIGNER_QWEN_BATCH_SIZE=2
ALIGNER_QWEN_CHUNK_MIN_MS=45000
ALIGNER_QWEN_CHUNK_TARGET_MS=90000

# STARS subprocess adapter. All paths must match the official STARS checkout.
ALIGNER_STARS_REPO_DIR=/opt/STARS
ALIGNER_STARS_INFERENCE_CMD=python inference/stars.py
ALIGNER_STARS_CHECKPOINT=/opt/STARS/checkpoints/stars_bilingual
ALIGNER_STARS_CONFIG=/opt/STARS/configs/stars_bilingual.yaml
ALIGNER_STARS_PHSET=/opt/STARS/chinese_and_english_phone_set.json
ALIGNER_STARS_PHONEME_CMD=python /app/tools/stars_mixedtext2json.py --stars-script /opt/STARS/scripts/mixedtext2phoneme.py
ALIGNER_STARS_CUDA_VISIBLE_DEVICES=0

# Validation.
ALIGNER_MIN_LINE_CONFIDENCE=0.55
ALIGNER_LOW_CONFIDENCE_POLICY=mark
ALIGNER_MAX_TOKEN_GAP_MS=2000
ALIGNER_MAX_BOUNDARY_SLOP_MS=650
